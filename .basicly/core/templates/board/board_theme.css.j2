{#- The board's one stylesheet head, included by every page inside its own `<style>`: the
    shared tokens from `kit/board/web/tokens.css` first (the tracker links the same file), the
    bridge that puts bootstrap's components on those tokens, and the board's own control and
    card skins. One file rather than four copies, so a card on the wall reads as a card on the
    loop and the backlog (basicly-lywzp71). `board_serve` dates its staleness off every
    template in this directory and the token file, so a change to either is seen by a running
    server (basicly-c309uki). #}
{% include "tokens.css" %}
      :root {
        --bs-body-bg: var(--bg);
        --bs-body-color: var(--text);
        --bs-body-color-rgb: 24, 24, 27;
        --bs-body-font-family: var(--font-sans);
        --bs-body-line-height: var(--leading-snug);
        --bs-emphasis-color: var(--text-strong);
        --bs-emphasis-color-rgb: 9, 9, 11;
        --bs-secondary-color: var(--muted);
        --bs-secondary-color-rgb: 99, 99, 110;
        --bs-tertiary-color: var(--muted);
        --bs-secondary-bg: var(--panel);
        --bs-tertiary-bg: var(--sunk);
        --bs-border-color: var(--line);
        --bs-border-color-translucent: var(--line);
        --bs-border-radius: var(--radius-1);
        --bs-border-radius-sm: calc(var(--radius-1) - 1px);
        --bs-border-radius-lg: var(--radius-2);
        --bs-primary: var(--accent);
        --bs-primary-rgb: 79, 70, 229;
        --bs-success: var(--ok);
        --bs-success-rgb: 22, 101, 52;
        --bs-warning: var(--warn);
        --bs-warning-rgb: 146, 64, 14;
        --bs-link-color: var(--accent);
        --bs-link-color-rgb: 79, 70, 229;
        --bs-link-hover-color: var(--accent);
        --bs-link-hover-color-rgb: 79, 70, 229;
        --bs-code-color: var(--accent);
        --bs-highlight-bg: transparent;
        --bs-font-sans-serif: var(--font-sans);
        --bs-font-monospace: var(--font-mono);
        --bs-focus-ring-color: var(--accent);
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bs-body-color-rgb: 215, 220, 230;
          --bs-emphasis-color-rgb: 242, 245, 250;
          --bs-secondary-color-rgb: 139, 147, 167;
          --bs-primary-rgb: 129, 140, 248;
          --bs-success-rgb: 52, 211, 153;
          --bs-warning-rgb: 245, 158, 11;
          --bs-link-color-rgb: 129, 140, 248;
          --bs-link-hover-color-rgb: 129, 140, 248;
        }
      }
      /* Bootstrap's reboot spaces a *document*. A board page is laid out by grid gaps and the
         spacing scale, so an element brings no margin of its own and a page opts back in
         where it reads as prose (the record body). Element selectors, because the reboot's
         are, and `* { margin: 0 }` loses to them. */
      h1, h2, h3, h4, h5, h6, p, ul, ol, dl, dd, pre, figure, blockquote, table, hr {
        margin: 0;
      }
      dt {
        font-weight: inherit;
      }
      /* The board's button: bootstrap's `.btn` semantics - the focus ring, the disabled state,
         one size - on basicly's hues, as a variant the way bootstrap 5.3 documents one. Quiet
         until pointed at, because twenty of these down a column must not outrank the titles
         beside them. */
      .btn-board {
        --bs-btn-padding-y: 0;
        --bs-btn-padding-x: var(--space-2);
        --bs-btn-font-family: var(--font-sans);
        --bs-btn-font-size: 12px;
        --bs-btn-font-weight: 600;
        --bs-btn-line-height: 1.4;
        --bs-btn-border-radius: 3px;
        --bs-btn-color: var(--muted);
        --bs-btn-bg: transparent;
        --bs-btn-border-color: transparent;
        --bs-btn-hover-color: var(--text);
        --bs-btn-hover-bg: transparent;
        --bs-btn-hover-border-color: var(--edge);
        --bs-btn-active-color: var(--text-strong);
        --bs-btn-active-bg: var(--panel);
        --bs-btn-active-border-color: var(--edge);
        --bs-btn-focus-box-shadow: 0 0 0 2px var(--accent);
        --bs-btn-disabled-color: var(--muted);
        --bs-btn-disabled-bg: transparent;
        --bs-btn-disabled-border-color: transparent;
      }
      /* The filled form, for the one control an operator came to press. */
      .btn-board-fill {
        --bs-btn-padding-y: var(--space-0);
        --bs-btn-padding-x: var(--space-4);
        --bs-btn-font-size: 13px;
        --bs-btn-color: var(--on-accent);
        --bs-btn-bg: var(--accent-fill);
        --bs-btn-border-color: var(--accent-fill);
        --bs-btn-hover-color: var(--on-accent);
        --bs-btn-hover-bg: var(--accent-fill-hover);
        --bs-btn-hover-border-color: var(--accent-fill-hover);
        --bs-btn-active-color: var(--on-accent);
        --bs-btn-active-bg: var(--accent-fill-hover);
        --bs-btn-active-border-color: var(--accent-fill-hover);
        --bs-btn-disabled-color: var(--on-accent);
        --bs-btn-disabled-bg: var(--accent-fill);
        --bs-btn-disabled-border-color: var(--accent-fill);
      }
      /* Stopping work is not the ordinary action on a running lane, so it is amber and
         outlined, never the indigo the rest of the page acts in. */
      .btn-board-stop {
        --bs-btn-padding-y: var(--space-0);
        --bs-btn-padding-x: var(--space-3);
        --bs-btn-color: var(--warn);
        --bs-btn-bg: var(--sunk);
        --bs-btn-border-color: var(--warn);
        --bs-btn-hover-color: var(--on-fill);
        --bs-btn-hover-bg: var(--warn-fill);
        --bs-btn-hover-border-color: var(--warn-fill);
        --bs-btn-active-color: var(--on-fill);
        --bs-btn-active-bg: var(--warn-fill);
        --bs-btn-active-border-color: var(--warn-fill);
        --bs-btn-focus-box-shadow: 0 0 0 2px var(--warn);
        --bs-btn-disabled-color: var(--warn);
        --bs-btn-disabled-bg: var(--sunk);
        --bs-btn-disabled-border-color: var(--warn);
      }
      /* The board's card: bootstrap's component on basicly's two surfaces. A region that
         frames itself is a raised card; a lane and a loop column's entry are sunk ones. */
      .card {
        --bs-card-bg: var(--sunk);
        --bs-card-color: var(--text);
        --bs-card-border-color: var(--line);
        --bs-card-border-radius: 4px;
        --bs-card-inner-border-radius: 3px;
        --bs-card-spacer-y: 0;
        --bs-card-spacer-x: 0;
      }
      .card.raised {
        --bs-card-bg: var(--panel);
        --bs-card-border-width: 2px;
        --bs-card-border-radius: 6px;
      }
      /* The board's table: bootstrap's on basicly's palette, with the document margin off. */
      .table {
        --bs-table-bg: transparent;
        --bs-table-color: var(--text);
        --bs-table-border-color: var(--line);
        --bs-table-striped-bg: var(--panel);
        --bs-table-hover-bg: var(--panel);
        --bs-table-hover-color: var(--text-strong);
        margin-bottom: 0;
      }
