{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --no-python-downloads python \"$(git rev-parse --show-toplevel)/.basicly/core/hooks/lefthook-runtime.py\" codex pretooluse",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand "
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --no-python-downloads python \"$(git rev-parse --show-toplevel)/.basicly/core/hooks/lefthook-runtime.py\" codex sessionstart",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand "
          }
        ]
      }
    ]
  }
}
