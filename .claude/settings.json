{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Bash(git status *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git worktree list *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(basicly status *)",
      "Bash(basicly tracker show *)",
      "Bash(basicly tracker list *)",
      "Bash(basicly tracker ready *)",
      "Bash(basicly tracker stats *)",
      "Bash(basicly check)",
      "Bash(basicly skills-check *)",
      "Bash(basicly styles-check *)",
      "Bash(basicly agents-check)",
      "Bash(basicly hooks-check)",
      "Bash(basicly permissions-check)",
      "Bash(basicly catalog lint)",
      "Bash(basicly verify)",
      "Bash(basicly verify --mode fast)",
      "Bash(basicly verify --mode full)",
      "Bash(basicly verify --mode staged)",
      "Bash(git ls-remote origin)",
      "Bash(git ls-remote --branches origin)",
      "Bash(git ls-remote --tags origin)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh release view *)",
      "Bash(gh release list *)",
      "Bash(gh workflow list *)",
      "Bash(gh workflow view *)",
      "Bash(basicly tracker write -- create *)",
      "Bash(basicly tracker write -- update *)",
      "Bash(basicly tracker write -- review *)",
      "Bash(basicly tracker write -- confirm *)",
      "Bash(basicly tracker write -- close *)",
      "Bash(basicly tracker write -- comments add *)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(rm -r -f*)",
      "Bash(rm -f -r*)",
      "Bash(git push --force*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push -f*)",
      "Bash(git push*--force*)",
      "Bash(git push*--no-verify*)",
      "Bash(git push*--no-gpg-sign*)",
      "Bash(git commit*--no-verify*)",
      "Bash(git commit*--no-gpg-sign*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*-f*)",
      "Bash(git rebase*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.env.local)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Bash(git *push*--no-verify*)",
      "Bash(git *push*--no-gpg-sign*)",
      "Bash(git *commit*--no-verify*)",
      "Bash(git *commit*--no-gpg-sign*)",
      "Bash(git *-c core.hooksPath*)",
      "Bash(git *-c core.hookspath*)",
      "Bash(git *push*--force*)",
      "Bash(git *push* -f*)",
      "Bash(git *push*--delete*)",
      "Bash(git *push* :**)",
      "Bash(git *push* +:**)",
      "Bash(gh release delete*)",
      "Bash(gh repo delete*)",
      "Bash(gh run delete*)",
      "Bash(git *reset*--hard*)",
      "Bash(git *clean*-f*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --no-python-downloads --python '>=3.14' python -X utf8 \"${CLAUDE_PROJECT_DIR}/.basicly/core/hooks/lefthook-runtime.py\" claude pretooluse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --no-python-downloads --python '>=3.14' python -X utf8 \"${CLAUDE_PROJECT_DIR}/.basicly/core/hooks/lefthook-runtime.py\" claude posttooluse"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --no-python-downloads --python '>=3.14' python -X utf8 \"${CLAUDE_PROJECT_DIR}/.basicly/core/hooks/lefthook-runtime.py\" claude sessionstart"
          }
        ]
      }
    ]
  },
  "subagentPromptCacheTtl": "1h",
  "skillListingBudgetFraction": 0.02
}
