# Normalize line endings to LF on checkout.
* text=auto eol=lf

# Explicitly treat common source files as text.
*.md text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.j2 text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf

# Treat binary files as binary (no line-ending conversion).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
# The tracker ledger is append-only, and two branches that each append conflict
# without a union merge. `-text` keeps git from rewriting a byte an event id is
# derived from. The glob is read off the kit's own `events.LOG_GLOB`. This rule
# must sit after any `*` rule to win.
events-*.jsonl -text merge=union
pending-*.jsonl -text merge=union
